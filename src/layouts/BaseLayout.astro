---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import '../styles/style.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  fonts?: 'default' | 'serif-cormorant';
  /** Hero 背景圖；提供時會預載，避免換頁／重整時先露出空白 */
  heroImage?: string;
}

const {
  title = '浪遊 Vagabonding',
  description = '走過的地方，留下的故事',
  bodyClass = 'page-index',
  heroImage,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-Hant-HK">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#edf0f2" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style is:inline>
      html, body { background: #edf0f2; }
    </style>
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}
    <!-- 預先抓其他頁的 hero 圖，客戶端換頁時不會再閃白 -->
    {['/img/main.jpg', '/img/home.jpg', '/img/about-bg.jpg', '/img/journey-bg.jpg']
      .filter((src) => src !== heroImage)
      .map((src) => <link rel="prefetch" as="image" href={src} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 字型樣式表不阻擋首次繪製：先以 print 載入，載完再套用；慢網路下才不會整頁空白幾秒 -->
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+HK:wght@500;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Noto+Serif+HK:wght@500;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <ClientRouter fallback="swap" />
    <script>
      // 客戶端換頁：略過標題入場動畫，並捲回頂部。
      // 注意：Astro 換頁時會重設 <html> 的屬性，所以要在 after-swap 之後再標記，
      // 否則標題每次都重播 1.1s 淡入，看起來像頁面閃了兩次。
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.dataset.vtNav = '';
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      });

      document.addEventListener('astro:page-load', () => {
        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }
      });
    </script>
  </head>
  <body class={bodyClass}>
    <slot name="hero" />
    <slot />
    <Footer />
  </body>
</html>
