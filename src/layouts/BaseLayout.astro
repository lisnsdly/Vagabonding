---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import '../styles/style.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  fonts?: 'default' | 'serif-cormorant';
  /** Hero 背景圖；提供時會預載，避免換頁／重整時先露出空白 */
  heroImage?: string;
}

const {
  title = '浪遊 Vagabonding',
  description = '走過的地方，留下的故事',
  bodyClass = 'page-index',
  heroImage,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-Hant-HK">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#edf0f2" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style is:inline>
      html, body { background: #edf0f2; }
    </style>
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}
    <!-- 預先抓其他頁的 hero 圖，客戶端換頁時不會再閃白 -->
    {['/img/main.jpg', '/img/home.jpg', '/img/about-bg.jpg', '/img/journey-bg.jpg']
      .filter((src) => src !== heroImage)
      .map((src) => <link rel="prefetch" as="image" href={src} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 字型樣式表不阻擋首次繪製：先以 print 載入，載完再套用；慢網路下才不會整頁空白幾秒 -->
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+HK:wght@500;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Noto+Serif+HK:wght@500;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <ClientRouter fallback="swap" />
    <script>
      /*
        手機：瀏覽器 View Transition 的整頁快照在行動版 Safari／Chrome 上
        會因網址列伸縮而被位移或縮放，看起來像圖片上下跳再撐滿。
        所以手機改用「DOM 複製層」做交叉淡出：
          1. 換頁前把目前 <body> 複製一份，放進固定全螢幕覆蓋層（視覺上與原頁 1:1）
          2. 略過瀏覽器 View Transition，直接替換 DOM
          3. 新頁在底下就位後，把覆蓋層淡出並移除
        全程沒有快照、沒有縮放、沒有單色遮罩。電腦版維持原本的 View Transition。
      */
      const OVERLAY_ID = 'page-ghost';
      const isMobileNav = () =>
        window.matchMedia('(max-width: 800px), (hover: none) and (pointer: coarse)').matches;

      let ghostPending = false;

      const buildGhost = () => {
        document.getElementById(OVERLAY_ID)?.remove();

        const body = document.body;
        const bodyStyle = getComputedStyle(body);
        const ghost = document.createElement('div');
        ghost.id = OVERLAY_ID;
        ghost.setAttribute('aria-hidden', 'true');
        ghost.inert = true;
        Object.assign(ghost.style, {
          position: 'fixed',
          inset: '0',
          zIndex: '2147483000',
          overflow: 'hidden',
          pointerEvents: 'none',
          backgroundColor: bodyStyle.backgroundColor,
          backgroundImage: bodyStyle.backgroundImage,
          opacity: '1',
          transition: 'opacity 280ms ease-out',
          willChange: 'opacity',
        });

        const sheet = document.createElement('div');
        Object.assign(sheet.style, {
          position: 'absolute',
          left: '0',
          right: '0',
          top: `${-window.scrollY}px`,
        });
        sheet.className = body.className;

        for (const node of Array.from(body.childNodes)) {
          if (node.nodeName === 'SCRIPT') continue;
          const copy = node.cloneNode(true);
          if (copy instanceof Element) {
            copy.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
            if (copy.hasAttribute('id')) copy.removeAttribute('id');
          }
          sheet.appendChild(copy);
        }
        ghost.appendChild(sheet);
        // 掛在 <html> 下而非 <body>，Astro 換頁時替換 body 才不會把它一起換掉
        document.documentElement.appendChild(ghost);
        return ghost;
      };

      document.addEventListener('astro:before-preparation', () => {
        ghostPending = isMobileNav();
        if (ghostPending) buildGhost();
      });

      document.addEventListener('astro:before-swap', (event) => {
        if (ghostPending) event.viewTransition?.skipTransition();
      });

      // 客戶端換頁：略過標題入場動畫，並捲回頂部。
      // 注意：Astro 換頁時會重設 <html> 的屬性，所以要在 after-swap 之後再標記，
      // 否則標題每次都重播 1.1s 淡入，看起來像頁面閃了兩次。
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.dataset.vtNav = '';
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });

        if (!ghostPending) return;
        ghostPending = false;
        const ghost = document.getElementById(OVERLAY_ID);
        if (!ghost) return;
        // 等新頁完成一次繪製再開始淡出
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            ghost.style.opacity = '0';
            const done = () => ghost.remove();
            ghost.addEventListener('transitionend', done, { once: true });
            window.setTimeout(done, 400);
          });
        });
      });

      document.addEventListener('astro:page-load', () => {
        // 保險：若換頁中途被中斷，不要留下殘影層
        if (!ghostPending) {
          const stale = document.getElementById(OVERLAY_ID);
          if (stale && stale.style.opacity !== '0') {
            window.setTimeout(() => stale.remove(), 400);
          }
        }
        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }
      });
    </script>
  </head>
  <body class={bodyClass}>
    <slot name="hero" />
    <slot />
    <Footer />
  </body>
</html>
