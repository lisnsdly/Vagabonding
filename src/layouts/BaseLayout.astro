---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import '../styles/style.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  fonts?: 'default' | 'serif-cormorant';
  /** Hero 背景圖；提供時會預載，避免換頁／重整時先露出空白 */
  heroImage?: string;
}

const {
  title = '浪遊 Vagabonding',
  description = '走過的地方，留下的故事',
  bodyClass = 'page-index',
  heroImage,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-Hant-HK">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#edf0f2" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style is:inline>
      html, body { background: #edf0f2; }
    </style>
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}
    <!-- 預先抓其他頁的 hero 圖，客戶端換頁時不會再閃白 -->
    {['/img/main.jpg', '/img/home.jpg', '/img/about-bg.jpg', '/img/journey-bg.jpg']
      .filter((src) => src !== heroImage)
      .map((src) => <link rel="prefetch" as="image" href={src} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 字型樣式表不阻擋首次繪製：先以 print 載入，載完再套用；慢網路下才不會整頁空白幾秒 -->
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+HK:wght@500;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Noto+Serif+HK:wght@500;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <ClientRouter fallback="swap" />
    <script>
      // 鎖定首屏高度：只在初次量測與轉螢幕時更新，換頁／網址列伸縮時不變。
      let appVh = 0;
      let mobileNavPending = false;

      const applyAppVh = () => {
        if (!appVh) appVh = window.innerHeight;
        document.documentElement.style.setProperty('--app-vh', `${appVh}px`);
      };
      const measureAppVh = () => {
        appVh = window.innerHeight;
        applyAppVh();
      };
      const isMobileNav = () =>
        window.matchMedia('(max-width: 800px), (hover: none) and (pointer: coarse)').matches;

      const ensureVeil = () => {
        let veil = document.getElementById('page-veil');
        if (!veil) {
          veil = document.createElement('div');
          veil.id = 'page-veil';
          document.body.appendChild(veil);
        }
        return veil;
      };

      measureAppVh();
      window.addEventListener('orientationchange', () => {
        setTimeout(measureAppVh, 350);
      });

      // 手機：關掉 View Transition morph（會把 hero 圖上下拉再撐滿），
      // 改以固定遮罩淡入淡出，畫面尺寸全程不變。
      document.addEventListener('astro:before-preparation', () => {
        mobileNavPending = isMobileNav();
        if (!mobileNavPending) return;
        const veil = ensureVeil();
        veil.classList.remove('is-on');
        void veil.offsetWidth;
        veil.classList.add('is-on');
      });

      document.addEventListener('astro:before-swap', (event) => {
        if (!mobileNavPending) return;
        event.viewTransition?.skipTransition();
      });

      // 客戶端換頁：略過標題入場動畫，並捲回頂部。
      // 注意：Astro 換頁時會重設 <html> 的屬性，所以要在 after-swap 之後再標記。
      document.addEventListener('astro:after-swap', () => {
        const root = document.documentElement;
        root.dataset.vtNav = '';
        applyAppVh();
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });

        if (!mobileNavPending) return;
        mobileNavPending = false;
        const veil = ensureVeil();
        veil.classList.add('is-on');
        void veil.offsetWidth;
        requestAnimationFrame(() => {
          veil.classList.remove('is-on');
          const cleanup = () => veil.remove();
          veil.addEventListener('transitionend', cleanup, { once: true });
          window.setTimeout(cleanup, 280);
        });
      });

      document.addEventListener('astro:page-load', () => {
        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }
      });
    </script>
  </head>
  <body class={bodyClass}>
    <slot name="hero" />
    <slot />
    <Footer />
  </body>
</html>
