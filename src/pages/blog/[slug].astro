---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { formatPostDate } from '../../lib/formatDate';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = formatPostDate(post.data.date, post.data.dateEnd);
---

<BaseLayout
  title={`${post.data.title} · 浪遊 Vagabonding`}
  description={post.data.excerpt || post.data.title}
  bodyClass="page-journey"
  fonts="serif-cormorant"
>
  <header class="post-topbar">
    <Header currentPath={`/blog/${post.id}`} solid />
  </header>

  <article class:list={['post-article', { 'post-article--village': post.id === 'village' }]}>
    {post.data.video ? (
      <div class="post-article__video">
        <video controls playsinline preload="metadata" poster={post.data.coverImage}>
          <source src={post.data.video} type="video/mp4" />
          你的瀏覽器不支援影片播放。
        </video>
        <div class="post-article__video-caption">
          <p class="post-article__meta">
            <span>{post.data.location}</span>
            <span>{formattedDate}</span>
          </p>
          <h1>{post.data.title}</h1>
        </div>
      </div>
    ) : (
      <div class="post-article__hero">
        <img src={post.data.coverImage} alt={post.data.title} />
        <div class="post-article__hero-overlay">
          <p class="post-article__meta">
            <span>{post.data.location}</span>
            <span>{formattedDate}</span>
          </p>
          <h1>{post.data.title}</h1>
        </div>
      </div>
    )}

    <div class="post-article__body prose">
      <Content />
    </div>

    <p class="post-article__back">
      {post.data.featuredOnHome ? (
        <a href="/home">← 返回屋企</a>
      ) : (
        <a href="/journey">← 返回旅途</a>
      )}
    </p>
  </article>
</BaseLayout>
