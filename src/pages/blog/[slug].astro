---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { formatPostDate } from '../../lib/formatDate';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = formatPostDate(post.data.date, post.data.dateEnd);

const titleParts = post.data.title.split(/\s*[—–-]{1,2}\s*/).filter(Boolean);
const titleMain = titleParts[0] ?? post.data.title;
const titlePlace = titleParts.length > 1 ? titleParts.slice(1).join(' · ') : null;
---

<BaseLayout
  title={`${post.data.title} · 浪遊 Vagabonding`}
  description={post.data.excerpt || post.data.title}
  bodyClass="page-journey"
  fonts="serif-cormorant"
>
  <div class="post-topbar">
    <Header currentPath={`/blog/${post.id}`} solid />
  </div>

  <article class="post-article">
    {post.data.video ? (
      <div class="post-article__media">
        <div class="post-article__video">
          <video controls playsinline preload="metadata" poster={post.data.coverImage}>
            <source src={post.data.video} type="video/mp4" />
            你的瀏覽器不支援影片播放。
          </video>
        </div>
        <div class="post-article__caption">
          <p class="post-article__meta">
            <span>{post.data.location}</span>
            <span>{formattedDate}</span>
          </p>
          <h1>
            <span class="post-article__title-main">{titleMain}</span>
            {titlePlace && <span class="post-article__title-place">{titlePlace}</span>}
          </h1>
        </div>
      </div>
    ) : (
      <div class="post-article__media">
        <div class="post-article__hero">
          <img src={post.data.coverImage} alt={post.data.title} />
        </div>
        <div class="post-article__caption">
          <p class="post-article__meta">
            <span>{post.data.location}</span>
            <span>{formattedDate}</span>
          </p>
          <h1>
            <span class="post-article__title-main">{titleMain}</span>
            {titlePlace && <span class="post-article__title-place">{titlePlace}</span>}
          </h1>
        </div>
      </div>
    )}

    <div class="post-article__body prose">
      <Content />
    </div>

    <p class="post-article__back">
      {post.data.featuredOnHome ? (
        <a href="/home">← 返回屋企</a>
      ) : (
        <a href="/journey">← 返回旅途</a>
      )}
    </p>
  </article>
</BaseLayout>
