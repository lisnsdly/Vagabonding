---
interface Props {
  currentPath?: string;
  solid?: boolean;
}

const { currentPath = '/', solid = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--solid': solid }]} role="banner">
  <div class="container">
    <nav class="nav-left" aria-label="主選單（左）">
      <ul>
        <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>首頁</a></li>
        <li><a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>關於我</a></li>
      </ul>
    </nav>

    <div class="logo">
      <a href="/" aria-label="返回首頁">
        <img src="/img/logo.png" alt="浪遊 Vagabonding 網站標誌" />
      </a>
    </div>

    <nav class="nav-right" aria-label="主選單（右）">
      <ul>
        <li><a href="/journey" aria-current={currentPath.startsWith('/journey') || currentPath.startsWith('/blog') ? 'page' : undefined}>旅途</a></li>
        <li><a href="/home" aria-current={currentPath === '/home' ? 'page' : undefined}>屋企</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function initHeaderScroll() {
    const header = document.querySelector('.site-header');
    const hasHero = document.querySelector('.background');

    if (!header || !hasHero || header.classList.contains('site-header--solid')) {
      return undefined;
    }

    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 80);
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    return () => window.removeEventListener('scroll', onScroll);
  }

  let cleanup = initHeaderScroll();

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = initHeaderScroll();
  });
</script>
