---
interface Props {
  currentPath?: string;
  solid?: boolean;
}

const { currentPath = '/', solid = false } = Astro.props;

const links = [
  { href: '/', label: '首頁', active: currentPath === '/' },
  { href: '/about', label: '關於我', active: currentPath === '/about' },
  {
    href: '/journey',
    label: '旅途',
    active: currentPath.startsWith('/journey') || currentPath.startsWith('/blog'),
  },
  { href: '/home', label: '屋企', active: currentPath === '/home' },
];
---

<header class:list={['site-header', { 'site-header--solid': solid }]} role="banner">
  <div class="container">
    <nav class="nav-left nav-desktop" aria-label="主選單（左）">
      <ul>
        {links.slice(0, 2).map((link) => (
          <li>
            <a href={link.href} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="logo">
      <a href="/" aria-label="返回首頁">
        <img src="/img/logo.png" alt="浪遊 Vagabonding 網站標誌" />
      </a>
    </div>

    <nav class="nav-right nav-desktop" aria-label="主選單（右）">
      <ul>
        {links.slice(2).map((link) => (
          <li>
            <a href={link.href} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="nav-toggle"
      aria-label="開啟選單"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="手機選單" hidden>
    <div class="mobile-menu__backdrop" data-menu-close aria-hidden="true"></div>
    <div class="mobile-menu__panel">
      <p class="mobile-menu__label">導覽</p>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  function initHeaderScroll() {
    const header = document.querySelector('.site-header');
    const hasHero = document.querySelector('.background');

    if (!header || !hasHero || header.classList.contains('site-header--solid')) {
      return undefined;
    }

    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 80);
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    return () => window.removeEventListener('scroll', onScroll);
  }

  function initMobileMenu() {
    const header = document.querySelector('.site-header');
    const toggle = document.querySelector('.nav-toggle');
    const menu = document.getElementById('mobile-menu');

    if (!toggle || !menu) return undefined;

    const close = () => {
      menu.classList.remove('is-open');
      menu.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '開啟選單');
      header?.classList.remove('is-menu-open');
      document.body.classList.remove('menu-open');
    };

    const open = () => {
      menu.removeAttribute('hidden');
      requestAnimationFrame(() => menu.classList.add('is-open'));
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', '關閉選單');
      header?.classList.add('is-menu-open');
      document.body.classList.add('menu-open');
    };

    const onToggle = () => {
      if (menu.classList.contains('is-open')) close();
      else open();
    };

    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') close();
    };

    toggle.addEventListener('click', onToggle);
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', close);
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', close);
    document.addEventListener('keydown', onKeyDown);

    return () => {
      toggle.removeEventListener('click', onToggle);
      document.removeEventListener('keydown', onKeyDown);
      close();
    };
  }

  let scrollCleanup = initHeaderScroll();
  let menuCleanup = initMobileMenu();

  document.addEventListener('astro:page-load', () => {
    scrollCleanup?.();
    menuCleanup?.();
    scrollCleanup = initHeaderScroll();
    menuCleanup = initMobileMenu();
  });
</script>
